import 'dart:async';
import 'dart:io';
import 'package:multicast_dns/multicast_dns.dart';

class MDnsService {
  static const String _serviceType = '_cpft._tcp.local';
  final MDnsClient _client = MDnsClient();
  Timer? _discoveryTimer;
  final List<Function(String, String)> _discoveryListeners = [];
  final Map<String, StreamSubscription> _subscriptions = {};
  bool _isInitialized = false;
  String? _localDeviceName;
  String? _localIpAddress;

  void addDiscoveryListener(Function(String, String) listener) {
    _discoveryListeners.add(listener);
    print('Added discovery listener, total listeners: \${_discoveryListeners.length}');
  }

  void removeDiscoveryListener(Function(String, String) listener) {
    _discoveryListeners.remove(listener);
  }

  Future<void> initialize() async {
    if (_isInitialized) return;

    try {
      // Start mDNS client
      await _client.start();
      
      // Find our local IP address
      var interfaces = await NetworkInterface.list();
      for (var interface in interfaces) {
        for (var addr in interface.addresses) {
          if (addr.type == InternetAddressType.IPv4 && !addr.isLoopback) {
            _localIpAddress = addr.address;
            print('Found local IP: \$_localIpAddress');
            break;
          }
        }
        if (_localIpAddress != null) break;
      }

      if (_localIpAddress == null) {
        throw Exception('Could not find a suitable network interface');
      }

      // Generate a unique device name
      var timestamp = DateTime.now().millisecondsSinceEpoch;
      var hostname = Platform.localHostname.replaceAll(RegExp(r'[^a-zA-Z0-9-]'), '-');
      _localDeviceName = 'cpft-\$hostname-\$timestamp';
      print('Generated device name: \$_localDeviceName');

      _isInitialized = true;
      print('mDNS client started successfully');
      
      // Start continuous discovery
      startDiscovery();
    } catch (e) {
      print('Error initializing mDNS client: \$e');
      rethrow;
    }
  }

  void startDiscovery() {
    if (!_isInitialized) {
      print('MDnsService not initialized. Call initialize() first.');
      return;
    }

    print('Starting device discovery');
    stopDiscovery();

    void discover() {
      try {
        print('Sending mDNS query for service type: \$_serviceType');
        var subscription = _client.lookup<PtrResourceRecord>(
          ResourceRecordQuery.serverPointer(_serviceType),
          timeout: const Duration(seconds: 2),
        ).listen(
          (ptr) {
            print('Found PTR record: \${ptr.domainName}');
            if (ptr.domainName != '\$_localDeviceName.\$_serviceType') {
              _lookupServiceDetails(ptr.domainName);
            }
          },
          onError: (e) => print('Error in PTR lookup: \$e'),
        );
        _subscriptions['discovery'] = subscription;

        // Also send our PTR record for others to discover
        _client.lookup<PtrResourceRecord>(
          ResourceRecordQuery.serverPointer(_serviceType),
          timeout: const Duration(seconds: 2),
        ).then((records) {
          print('Publishing PTR record: \$_localDeviceName.\$_serviceType');
        }).catchError((e) => print('Error publishing PTR record: \$e'));
      } catch (e) {
        print('Error in discovery: \$e');
      }
    }

    discover();
    _discoveryTimer = Timer.periodic(const Duration(seconds: 5), (_) => discover());
  }

  void stopDiscovery() {
    print('Stopping device discovery');
    _discoveryTimer?.cancel();
    _discoveryTimer = null;
    
    for (var subscription in _subscriptions.values) {
      subscription.cancel();
    }
    _subscriptions.clear();
  }

  void dispose() {
    print('Disposing MDnsService');
    stopDiscovery();
    
    if (_isInitialized) {
      _client.stop();
      _isInitialized = false;
    }
  }

  void _lookupServiceDetails(String domainName) {
    _subscriptions[domainName]?.cancel();
    
    print('Looking up service details for: \$domainName');
    _subscriptions[domainName] = _client.lookup<SrvResourceRecord>(
      ResourceRecordQuery.service(domainName),
      timeout: const Duration(seconds: 2),
    ).listen(
      (srv) {
        print('Found service: \${srv.name} at \${srv.target}:\${srv.port}');
        _lookupIPAddress(srv.target, srv.name);
      },
      onError: (e) => print('Error in SRV lookup: \$e'),
    );
  }

  void _lookupIPAddress(String target, String serviceName) {
    print('Looking up IP address for: \$target');
    var subscription = _client.lookup<IPAddressResourceRecord>(
      ResourceRecordQuery.addressIPv4(target),
      timeout: const Duration(seconds: 2),
    ).listen(
      (ip) {
        final String address = ip.address.address;
        print('Found IP for \$serviceName: \$address');
        
        // Skip our own IP
        if (address != _localIpAddress) {
          for (final listener in _discoveryListeners) {
            listener(serviceName, address);
          }
        } else {
          print('Skipping our own IP address');
        }
      },
      onError: (e) => print('Error in IP lookup: \$e'),
    );
    
    _subscriptions['\$target-ip'] = subscription;
  }
}
