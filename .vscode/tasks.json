{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Flutter Analyze",
			"type": "shell",
			"command": "flutter --no-version-check analyze",
			"isBackground": false,
			"problemMatcher": [
				"$dart-json"
			],
			"group": "build"
		},
		{
			"label": "Dart Analyze (errors only)",
			"type": "shell",
			"command": "dart analyze",
			"isBackground": false,
			"problemMatcher": [
				"$dart-json"
			],
			"group": "build"
		}
	]
}